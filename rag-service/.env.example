# Copy to .env. Everything here is optional; with no changes the service runs BM25-only.

# Required only if the agent sends X-API-Key (must match RAG_API_KEY in agent-orchestrator/.env).
RAG_API_KEY=

# Host runs (python -m ...). Docker sets these itself.
RAG_DATA_DIR=../data
RAG_INDEX_DIR=index

# Index the 19 out-of-scope tax Acts as retrieval distractors (default: no).
RAG_INCLUDE_OUT_OF_SCOPE=0

# Dense retrieval: any OpenAI-compatible embeddings endpoint. Base URL includes /v1.
# Changing the model re-embeds the corpus once at the next start or build.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_CA_CERT=
EMBEDDING_BATCH_SIZE=32
# Instruction prefixes for models that expect them (e.g. e5: "query: " / "passage: ").
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# Optional reranker: POST {base}/rerank with {query, documents, top_n} (vLLM, TEI, Infinity, Jina, Cohere-style).
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_CA_CERT=
RERANK_CANDIDATES=30
