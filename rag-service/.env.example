# Copy to .env. Everything here is optional; with no changes the service runs BM25-only.

# Required only if the agent sends X-API-Key (must match RAG_API_KEY in agent-orchestrator/.env).
RAG_API_KEY=

# Host runs (python -m ...). Docker sets these itself.
RAG_DATA_DIR=../data
RAG_INDEX_DIR=index

# Index the 19 out-of-scope tax Acts as retrieval distractors (default: no).
RAG_INCLUDE_OUT_OF_SCOPE=0

# Dense retrieval: any OpenAI-compatible embeddings endpoint. Base URL includes /v1.
# Leave EMBEDDING_BASE_URL empty for keyword search only. The values below are for the
# course's shared BGE server; the key comes from your coordinator.
# Changing the model re-embeds the corpus once at the next start (progress is saved).
EMBEDDING_BASE_URL=https://103.42.50.41:1035/v1
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_API_KEY=sk-ucwh-7vEEfPHRit6WNtNjPhtq4IPmWM7zTmyk1Wfx6iQt8Ka
EMBEDDING_CA_CERT=./certificate/vm02-ca.crt
# The shared server accepts at most 16 texts per request and 512 tokens per text.
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_TOKENS=512
# BGE v1.5 instruction for short search queries (documents get no prefix). Keep the quotes.
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
EMBEDDING_DOCUMENT_PREFIX=

# Optional reranker: POST {base}/rerank with {query, documents, top_n} (vLLM, TEI, Infinity, Jina, Cohere-style).
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_CA_CERT=
RERANK_CANDIDATES=30
