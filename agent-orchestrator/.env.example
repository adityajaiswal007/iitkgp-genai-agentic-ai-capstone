# Hosted inference. Use demo only for offline development.
AGENT_MODE=qwen
AGENT_DATABASE_PATH=data/conversations.sqlite
# Optional shared service key. Set for deployments; clients send X-API-Key.
AGENT_API_KEY=
AGENT_MAX_STEPS=10
AGENT_MAX_REVISIONS=1
AGENT_TOKEN_BUDGET=48000
AGENT_MAX_OUTPUT_TOKENS=900
AGENT_TIMEOUT_SECONDS=30
AGENT_QUERY_SECONDS=120

# Used only in qwen mode. Never commit your real API key.
QWEN_BASE_URL=https://103.42.50.41:1033/v1
QWEN_MODEL=Qwen/Qwen3-8B
QWEN_API_KEY=
# Optional CA bundle path. Local Python uses this path; Docker needs compose.qwen.yaml.
QWEN_CA_CERT=./certificate/model.crt
QWEN_JSON_MODE=none
QWEN_DISABLE_THINKING=0

# Local document-retrieval service; unset only for synthetic demo testing.
RAG_BASE_URL=http://127.0.0.1:8001
RAG_API_KEY=

# Optional orchestrator query-vector endpoint. Disabled while the base URL is blank.
# This does not change or configure document-retrieval.
# Set EMBEDDING_BASE_URL=https://103.42.50.41:1035/v1 to enable it.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_API_KEY=
# Use the host certificate path locally; add compose.embeddings.yaml for Docker.
EMBEDDING_CA_CERT=./certificate/embedding.crt
EMBEDDING_TIMEOUT_SECONDS=15
# Optional strict dimension contract, agreed with the retrieval/index team.
EMBEDDING_DIMENSIONS=
