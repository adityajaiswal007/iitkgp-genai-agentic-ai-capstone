# Copy to .env and fill QWEN_API_KEY. Paths assume commands run in agent-orchestrator.
AGENT_MODE=qwen
QWEN_BASE_URL=https://103.42.50.41:1033/v1
QWEN_API_KEY=
QWEN_CA_CERT=./certificate/vm05-ca.crt

# Optional: this is also the client's default model.
QWEN_MODEL=Qwen/Qwen3-8B
QWEN_JSON_MODE=none
QWEN_DISABLE_THINKING=0

RAG_BASE_URL=http://127.0.0.1:8001
RAG_API_KEY=
