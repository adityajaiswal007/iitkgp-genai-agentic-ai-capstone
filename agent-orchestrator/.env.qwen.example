# Copy to .env and supply these three connection values.
AGENT_MODE=qwen
QWEN_BASE_URL=https://103.42.50.41:1034/v1
QWEN_API_KEY=replace-with-your-api-key
QWEN_CA_CERT=${HOME}/Downloads/vm05-ca.crt

# Optional: this is also the client's default model.
QWEN_MODEL=Qwen/Qwen3-8B
QWEN_JSON_MODE=none
QWEN_DISABLE_THINKING=0
