# Merge these settings into your existing .env; preserve Qwen and retrieval settings.
EMBEDDING_BASE_URL=https://103.42.50.41:1035/v1
EMBEDDING_MODEL=bge-small-en-v1.5
# Optional. Set only if the embedding service requires a bearer token.
# QWEN_API_KEY is never automatically reused here.
EMBEDDING_API_KEY=
EMBEDDING_CA_CERT=/certificate/embedding.crt
EMBEDDING_TIMEOUT_SECONDS=15
# Optional: set the actual dimension agreed with the retrieval team.
EMBEDDING_DIMENSIONS=
