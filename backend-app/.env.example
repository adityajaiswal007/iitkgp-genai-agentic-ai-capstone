# Local development only. Copy to .env and replace the password.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=copilot
DB_PASSWORD=replace-with-a-local-password
DB_NAME=operations_copilot
DB_SSL=false
TEST_DB_NAME=operations_copilot_test

# Redis for shared browser quotas. Port 6380 avoids an existing local Redis on 6379.
REDIS_URL=redis://127.0.0.1:6380
REDIS_PORT=6380
RATE_LIMIT_KEY_PREFIX=operations-copilot:rate-limit:v1
RATE_LIMIT_API_COUNT=120
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_COUNT=20
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_BLOCK_SECONDS=60

# Agent service; Qwen credentials belong only in agent-orchestrator/.env.
AGENT_BASE_URL=http://127.0.0.1:8000
AGENT_API_KEY=
# Must exceed AGENT_QUERY_SECONDS (120 seconds by default).
AGENT_REQUEST_TIMEOUT_MS=130000
